<?xml version="1.0" encoding="utf-8"?>
<!-- SMOKE build variant: asInvoker so the release gate can launch it
     headlessly without a UAC prompt. The engines degrade silently when
     unelevated; the startup path under test (window + resources + nav)
     is elevation-independent. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="AutoTrack.smoke"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
