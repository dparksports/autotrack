<Window x:Class="AutoTrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls"
        xmlns:views="using:AutoTrack.Views"
        Title="AutoTrack — service connection tracker">

    <Grid Background="{ThemeResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- tab strip -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,10,16,6" Spacing="8">
            <ToggleButton x:Name="TrackerTabBtn" Content="🛰 Service tracker" IsChecked="True" MinWidth="150" Checked="TrackerTab_Checked"/>
            <ToggleButton x:Name="PhoneHomeTabBtn" Content="📶 Phone home" MinWidth="130" Checked="PhoneHomeTab_Checked"/>
            <ToggleButton x:Name="TraceTabBtn" Content="🔍 Trace" MinWidth="100" Checked="TraceTab_Checked"/>
        </StackPanel>

        <!-- Tracker tab -->
        <Grid Grid.Row="1" x:Name="TrackerPane">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="16,0,16,4">
                <TextBlock Text="🛰 Service tracker" Style="{ThemeResource Header}"/>
                <TextBlock Text="What the services on your blocked list are connecting to right now — and which of their connects your blocks are dropping. Blocks you create here are AT-BLOCK rules, reversible."
                           Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="16,4,16,4">
                <StackPanel x:Name="ServiceChips" Orientation="Horizontal" Spacing="6"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,4,16,8" Spacing="12">
                <Button x:Name="PauseBtn" Content="⏸ Pause" Click="PauseBtn_Click" MinWidth="90"/>
                <Button Content="⟳ Refresh blocks now" Click="RefreshBlocks_Click" MinWidth="150"/>
                <Button Content="🚑 Restore Internet (all apps)" Click="Panic_Click" MinWidth="200"/>
                <CheckBox x:Name="BlockedOnlyCheck" Content="Blocked attempts only" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11"
                           Foreground="{ThemeResource TextSecondaryBrush}" Text="starting…"/>
            </StackPanel>

            <dg:DataGrid Grid.Row="3" x:Name="TrackGrid" AutoGenerateColumns="False" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="11" SelectionMode="Single"
                         RightTapped="TrackGrid_RightTapped">
                <dg:DataGrid.Resources>
                    <MenuFlyout x:Name="RowMenu">
                        <MenuFlyoutItem Text="⛔ Block this address" Click="BlockIp_Click"/>
                        <MenuFlyoutItem Text="✕ Unblock this address" Click="UnblockIp_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="⛔ Block every destination of this service…" Click="BlockService_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="🔍 Trace this process…" Click="TraceProcess_Click"/>
                    </MenuFlyout>
                </dg:DataGrid.Resources>
                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="90"/>
                    <dg:DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="120"/>
                    <dg:DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="56"/>
                    <dg:DataGridTextColumn Header="Remote" Binding="{Binding RemoteEndpoint}" Width="190"/>
                    <dg:DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/>
                    <dg:DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="150"/>
                    <dg:DataGridTextColumn Header="Blocked by" Binding="{Binding BlockedBy}" Width="110"/>
                    <dg:DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*"/>
                </dg:DataGrid.Columns>
            </dg:DataGrid>

            <Border Grid.Row="4" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="12,6">
                <TextBlock x:Name="FooterText" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"
                           Text="AutoTrack"/>
            </Border>
        </Grid>

        <!-- Phone home tab -->
        <Grid Grid.Row="1" x:Name="PhoneHomePane" Visibility="Collapsed">
            <views:PhoneHomeView/>
        </Grid>

        <!-- Trace tab -->
        <Grid Grid.Row="1" x:Name="TracePane" Visibility="Collapsed">
            <views:TraceView x:Name="TracePage"/>
        </Grid>
    </Grid>
</Window>
