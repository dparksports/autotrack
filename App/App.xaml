<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AutoTrack.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="BackgroundColor">#171B22</Color>
            <Color x:Key="SurfaceColor">#1F242E</Color>
            <Color x:Key="BorderColor">#39414F</Color>
            <Color x:Key="TextPrimaryColor">#F1F4F9</Color>
            <Color x:Key="TextSecondaryColor">#98A2B3</Color>
            <Color x:Key="AccentRedColor">#F87171</Color>
            <Color x:Key="AccentGreenColor">#34D399</Color>
            <Color x:Key="AccentAmberColor">#FBBF24</Color>
            <SolidColorBrush x:Key="BackgroundBrush" Color="{ThemeResource BackgroundColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}"/>
            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource BorderColor}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="AccentRedBrush" Color="{ThemeResource AccentRedColor}"/>
            <SolidColorBrush x:Key="AccentGreenBrush" Color="{ThemeResource AccentGreenColor}"/>
            <SolidColorBrush x:Key="AccentAmberBrush" Color="{ThemeResource AccentAmberColor}"/>
            <Style x:Key="Header" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
