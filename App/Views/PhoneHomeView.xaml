<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoTrack.Views.PhoneHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <!-- WinUI port of AutoCommand's PhoneHomeView (WPF UserControl).
         House pattern: DynamicResource→ThemeResource (only the app theme
         keys + the Header style exist), the WPF visibility converters and
         DataTriggers are replaced by code-behind (row visuals via
         ContainerContentChanging, the whole detail pane is populated from
         code-behind on selection), DockPanel→Grid rows, ToolTip→
         ToolTipService.ToolTip. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Margin="24,18,24,6">
            <TextBlock Text="📶 Phone Home" Style="{ThemeResource Header}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}"
                       Text="What Windows' own talkers are doing — pick a row for the full story: how often it phones out, to whom, and whether that's normal. Quiet the ones you don't want, with receipts."/>
            <TextBlock x:Name="StatusText" Text="Reading the archive…" FontSize="12"
                       Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- WinUI port: the original footer also described the 'Quiet it'
             hosts-pin sinkhole receipts (AutoCommand's Black Hole surface,
             not in this build — see the collapsed stub in the detail pane)
             and an app "Blocks tab" that does not exist here; the sentence
             below points at the real undo surface instead. -->
        <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="11" Margin="24,6,24,10"
                   Foreground="{ThemeResource TextSecondaryBrush}" Opacity="0.8"
                   Text="Frequencies come from the local Sysmon archive (last 24 h) and the live connection table — nothing leaves the machine. Destination blocks are ordinary AutoTrack firewall rules (AT-BLOCK-IP, provenance in the rule description) — reversible by deleting the rule in Windows Defender Firewall (wf.msc)."/>

        <!-- master-detail -->
        <Grid Grid.Row="1" Margin="24,6,24,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: one compact row per service, many at once -->
            <Border Grid.Column="0" Background="{ThemeResource SurfaceBrush}"
                    BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Services (by measured connects/hr)"
                               FontSize="12" FontWeight="SemiBold" Margin="10,8,10,4"
                               Foreground="{ThemeResource TextSecondaryBrush}"/>
                    <!-- WinUI port: ListBox → ListView (ContainerContentChanging,
                         used for the row visuals below, is ListViewBase-only) -->
                    <ListView Grid.Row="1" x:Name="RowList" Background="Transparent" BorderThickness="0"
                              Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionMode="Single"
                              SelectionChanged="RowList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- WinUI port: dot fill + marker visibilities
                                         (WPF VerdictDot style DataTriggers and
                                         BoolToVis converter) are applied in
                                         code-behind (ContainerContentChanging) -->
                                    <Ellipse x:Name="VerdictDot" Grid.Column="0" Width="9" Height="9"
                                             VerticalAlignment="Center" Margin="0,0,8,0" Fill="#98A2B3"/>

                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="QuietMark" Text="🔇" FontSize="11" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" Visibility="Collapsed"
                                                       ToolTipService.ToolTip="Quieted — endpoints pinned, attempts denied"/>
                                            <TextBlock x:Name="BeaconMark" Text="⚠" FontSize="11" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" Foreground="#FBBF24"
                                                       Visibility="Collapsed"
                                                       ToolTipService.ToolTip="Regular-interval (beacon-like) pattern detected — see detail"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ChipProcess}" FontSize="11"
                                                   Foreground="{ThemeResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding RowMetrics}" FontSize="11"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- RIGHT: detail pane for the selected row.
                 WinUI port: no ElementName/SelectedItem binding and no
                 converters — the pane's named elements are populated from
                 code-behind on selection change. -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left" Margin="0,0,8,8">

                        <Border Background="{ThemeResource SurfaceBrush}"
                                BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border Background="#14FFFFFF" CornerRadius="9" Padding="8,2"
                                                Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ChipProcessText" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"/>
                                        </Border>
                                        <!-- WinUI port: ChipImpactKind DataTriggers →
                                             background set in code-behind -->
                                        <Border x:Name="ImpactChip" Background="#14FFFFFF" CornerRadius="9"
                                                Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ImpactChipText" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <!-- WinUI port: WPF VerdictChip style + DataTriggers →
                                         plain border, colors set in code-behind -->
                                    <Border x:Name="VerdictChip" Grid.Column="1" CornerRadius="9"
                                            Padding="8,2" VerticalAlignment="Center"
                                            BorderThickness="1" MaxWidth="360">
                                        <TextBlock x:Name="VerdictChipText" FontSize="11"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="StoryText" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>

                                <!-- 24-hour histogram (oldest → newest, UTC buckets) -->
                                <TextBlock Text="Connects per hour, last 24 h" FontSize="11"
                                           Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <Border Height="42" Background="#0EFFFFFF" CornerRadius="4" Padding="3,3,3,2"
                                        HorizontalAlignment="Left" MinWidth="280">
                                    <ItemsControl x:Name="BarsList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Rectangle Width="9" Height="{Binding Height}" Margin="0,0,1,0"
                                                           Fill="#53B4E8" VerticalAlignment="Bottom"
                                                           ToolTipService.ToolTip="{Binding Label}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <TextBlock x:Name="MetricsText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,3"/>
                                <TextBlock x:Name="BytesText" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,3"/>

                                <TextBlock Text="Destinations (24 h)" FontSize="11"
                                           Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,6,0,2"/>
                                <ItemsControl x:Name="DestList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Display}" FontSize="12"
                                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{Binding Display}"/>
                                                <Button Grid.Column="1" Content="⛔ block" FontSize="11" Padding="6,1"
                                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Tag="{Binding Ip}"
                                                        Click="BlockOneBtn_Click"
                                                        ToolTipService.ToolTip="Block this one destination (outbound firewall rule, reversible)"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- WinUI port: CountToVis converter → Visibility set in code-behind -->
                                <TextBlock x:Name="NoDestsHint" Text="No destinations in the archive window" FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           Visibility="Collapsed"/>

                                <TextBlock x:Name="BeaconText" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,6,0,3"/>
                                <TextBlock x:Name="IdentityText" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <!-- WinUI port: NonEmptyToVis converter → Visibility set in code-behind -->
                                <TextBlock x:Name="ReceiptsText" TextWrapping="Wrap" FontSize="12"
                                           Foreground="#34D399" Margin="0,0,0,3" Visibility="Collapsed"/>
                                <TextBlock x:Name="FootnoteText" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{ThemeResource TextSecondaryBrush}" Opacity="0.8" Margin="0,0,0,8"/>

                                <!-- WinUI port (not in this build): the "🔇 Quiet it — keep
                                     receipts" hosts-pin surface is AutoCommand's — its
                                     SinkholeService listens on 127.0.0.1 and
                                     TelemetryProofService turns the denied attempts into
                                     receipts, and the pin lines use TelemetryRulesService's
                                     marker format so the Black Hole tab can undo them. None
                                     of those services are in AutoTrack: a pin here would
                                     deny silently with NO receipts, so the honest port is
                                     this collapsed stub with the original header preserved
                                     rather than a button that cannot keep its promise. -->
                                <StackPanel x:Name="QuietSection" Orientation="Vertical" Margin="0,0,0,8"
                                            Visibility="Collapsed">
                                    <TextBlock Text="🔇 Quiet it — keep receipts · ↩ Undo quiet" FontSize="12"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Not in this build — hosts-pin sinkholing with receipts is an AutoCommand feature (Black Hole tab). AutoTrack reports only."
                                               TextWrapping="Wrap" FontSize="11"
                                               Foreground="{ThemeResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="⛔ Block top destinations" Padding="10,4"
                                            Click="BlockBtn_Click"
                                            ToolTipService.ToolTip="Blocks this service's top 3 measured destinations at once"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- no-selection hint (WinUI port: NullToVis inverse →
                     Visibility set in code-behind) -->
                <TextBlock x:Name="NoSelectionHint" Text="Pick a service on the left to see its full story." FontSize="13"
                           Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
